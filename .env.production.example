# Runtime-only configuration. Replace placeholders through the approved secret source.
APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://replace-with-application-host.invalid
# Empty for direct Nginx/FastCGI TLS. If a proxy is introduced, list only its IP/CIDR.
TRUSTED_PROXIES=

LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
# Mount the reviewed RDS regional/global CA bundle read-only at this runtime path.
DB_SSLROOTCERT=

CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Redis stays optional; change each selected driver independently.
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379
